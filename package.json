{
  "name": "pi-memory",
  "version": "0.1.0",
  "description": "Persistent cross-session memory for pi, adapted from Codex CLI's memory pipeline (v1 and v2)",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\" \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify-upstream": "node scripts/verify-upstream.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3"
  }
}
